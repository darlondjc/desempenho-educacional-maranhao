*.xdv

# Arquivos temporários do sistema
*~
*.bak
*.tmp

# Diretórios comuns de build
_build/
build/
output/

# Arquivos do VS Code
.vscode/

# Ignorar arquivos de backup do Emacs
*#

# Ignorar arquivos de backup do vim
*.swp
*.swo

# Arquivos auxiliares do biblatex e prévia identificada
*.bcf
*.run.xml
revistas/*/main_identificado.pdf

# Skills de agentes instaladas localmente (npx skills add)
.agents/
.claude/skills/
skills-lock.json

# Assinatura manuscrita (não publicar no GitHub)
imagens/assinatura.*
revistas/*/assinatura.png
revistas/rbie/coverletter.pdf
revistas/rbie/submissao/carta_apresentacao.pdf
revistas/*/submissao/*.zip
